# Flask Secret Key for session signing
SECRET_KEY=replace-with-a-secure-random-secret-key

# Optional: Cloud PostgreSQL connection string (from Neon.tech or Supabase)
# If omitted, application safely defaults to local SQLite (revenue.db)
DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Web server port
PORT=5000
